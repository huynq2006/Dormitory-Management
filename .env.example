# File  này mn copy y hệt vào trong file .env(tự tạo) nhé, nhớ đổi password cho root

# PASSWORD FOR ROOT ACCOUNT (set your own secure password here)
MYSQL_ROOT_PASSWORD=<insert_root_password_here>


# Database name that will be automatically created
MYSQL_DATABASE=dormitory_management

# Allow root access from any host (for development purposes only, not recommended for production)
MYSQL_ROOT_HOST=%

# Application account (Used for Backend to write data) - FILLED AS REQUIRED
MYSQL_USER=app_user
MYSQL_PASSWORD=App_Pass@123

# Account and password for Master-Slave data synchronization
REPL_USER=repl_user
REPL_PASSWORD=Repl_Pass@123

# --- BACKEND CONFIGURATION (Used for Python script internal connection) ---
DB_MASTER_HOST=mysql-master
DB_SLAVE_HOST=mysql-slave
DB_PORT=3306

# Standard connection URLs for Python to connect (automatically using MYSQL_USER and MYSQL_PASSWORD from above)
DB_MASTER_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql-master:3306/${MYSQL_DATABASE}
DB_SLAVE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql-slave:3306/${MYSQL_DATABASE}
