# File  này mn copy y hệt vào trong file .env(tự tạo) nhé, nhớ đổi password cho root

# PASSWORD FOR ROOT ACCOUNT (set your own secure password here)
MYSQL_ROOT_PASSWORD=<insert_root_password_here>

MYSQL_ROOT_HOST=%

# Database name that will be automatically created
MYSQL_DATABASE=dormitory_management

# Account and password for Master-Slave data synchronization
REPL_USER=repl_user
REPL_PASSWORD=Repl_Pass@123
